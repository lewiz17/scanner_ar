# ============================================================
# Tarjetas Mágicas — variables de entorno (configurar en Vercel)
# Settings → Environment Variables. Ver DESPLIEGUE-PRUEBA.md.
# ============================================================

# Neon (Postgres): connection string completo de tu proyecto Neon.
# Formato: postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/tarjetas?sslmode=require
DATABASE_URL=

# Cloudflare R2: panel de Cloudflare → R2 → tu cuenta.
# Account ID: está en la portada de R2 ("Account ID").
R2_ACCOUNT_ID=
# Token API de R2 (Object Read & Write sobre el bucket): R2 → Manage R2 API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre exacto del bucket privado.
R2_BUCKET=tarjetas-magicas

# Secreto con el que se firman las sesiones (admin e invitados).
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Cuenta administradora inicial: se crea al ejecutar la inicialización
# de la base de datos desde el panel (botón «Inicializar base de datos»).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Secreto que protege el endpoint de inicialización (/api/admin/setup).
# Solo hay que escribirlo una vez en el panel. Genera otro distinto:
# openssl rand -hex 32
SETUP_SECRET=

# (Opcional) URL pública definitiva de la app, sin barra final.
# Ej.: https://tarjetas.tudominio.com — si se deja vacío se usa el
# dominio desde el que se abre la página.
PUBLIC_BASE_URL=
